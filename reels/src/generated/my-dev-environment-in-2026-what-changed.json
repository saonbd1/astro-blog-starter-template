  "scenes": [
    {
      "type": "title",
      "kicker": "Developer Productivity",
      "title": "My dev environment in 2026 — what changed, what stayed",
      "subtitle": "I do this annual audit of my dev setup. What tools did I keep? What did I finally ditch?",
      "durationInFrames": 105
    },
    {
      "type": "point",
      "kicker": "Developer Productivity",
      "heading": "What stayed",
      "body": "Neovim — still my primary editor. LazyVim makes config maintenance bearable. Tmux — session management. I live in it.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "Developer Productivity",
      "heading": "What’s new",
      "body": "Zellij — I’m testing it as a tmux replacement. The UI is friendlier. Ghostty — fastest terminal I’ve used. GPU-rendered, minimal.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "Developer Productivity",
      "heading": "What I dropped",
      "body": "VS Code is gone from my daily rotation. I used it for 4 years, but Neovim + Cursor cover everything it did, better.",
      "durationInFrames": 120
    },
    {
      "type": "outro",
      "heading": "Read the full article",
      "body": "New posts every week on the blog.",
      "url": "techtips.fun",
      "durationInFrames": 105
    }
  ],
