  "scenes": [
    {
      "type": "title",
      "kicker": "PC Troubleshooting",
      "title": "Fix Windows 11 Stuck on Getting Updates Loop in 5 Steps",
      "subtitle": "Windows 11 stuck on the Getting updates loop? Run 5 fixes in order, from a simple restart…",
      "durationInFrames": 105
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Before You Start",
      "body": "Make sure that the computer has at least 10 GB of free disk space. Make sure that the computer has a stable network connection. Save your open work.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Method 1: Wait, Then Restart",
      "body": "One update can need up to two hours on a slow network. If the message \"Getting updates\" does not change after 30 minutes, restart the computer.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "PC Troubleshooting",
      "heading": "Method 2: Run the Windows Update Troubleshooter",
      "body": "Windows Update includes a troubleshooter for common problems. Select Start > Settings > System > Troubleshoot > Other troubleshooters.",
      "durationInFrames": 120
    },
    {
      "type": "code",
      "kicker": "Code",
      "heading": "Method 3: Reset the Update Cache",
      "steps": [
        {
          "lang": "text",
          "meta": "",
          "value": "net stop wuauserv\nnet stop bits\nnet stop cryptsvc",
          "code": "net stop wuauserv\nnet stop bits\nnet stop cryptsvc",
          "tokens": [
            [
              "net stop wuauserv",
              null
            ],
            "\n",
            [
