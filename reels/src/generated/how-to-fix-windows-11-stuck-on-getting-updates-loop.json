          }
        },
        {
          "lang": "text",
          "meta": "",
          "value": "ren C:\\Windows\\SoftwareDistribution SoftwareDistribution.old\nren C:\\Windows\\System32\\catroot2 catroot2.old",
          "code": "ren C:\\Windows\\SoftwareDistribution SoftwareDistribution.old\nren C:\\Windows\\System32\\catroot2 catroot2.old",
          "tokens": [
            [
