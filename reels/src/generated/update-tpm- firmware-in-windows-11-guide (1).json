    {
      "type": "title",
      "kicker": "PC Troubleshoot",
      "title": "Update TPM firmware in Windows 11: A safe step-by-step guide",
      "subtitle": "Learn how to update TPM firmware in Windows 11, clear TPM safely, protect BitLocker data,…",
      "durationInFrames": 105
    },
    {
      "type": "point",
      "kicker": "PC Troubleshoot",
      "heading": "Check the TPM status before making changes",
      "body": "Start by confirming that Windows can see the TPM and checking its specification version.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "PC Troubleshoot",
      "heading": "Use Windows Security",
      "body": "Open Settings. Select Privacy & security. Select Windows Security. Select Device security. Select Security processor details.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "PC Troubleshoot",
      "heading": "Use TPM Management",
      "body": "Press Windows + R. Type tpm.msc. Select OK. Read the status message in the TPM Management window.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "PC Troubleshoot",
      "heading": "Prepare for a TPM firmware update",
      "body": "A TPM firmware update can change the TPM's state. A BIOS or UEFI update can also cause BitLocker to request its recovery key.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "PC Troubleshoot",
      "heading": "How to update TPM firmware in Windows 11",
      "body": "TPM firmware usually comes from the computer or motherboard manufacturer.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "PC Troubleshoot",
      "heading": "Step 1: Install Windows updates first",
      "body": "Open Settings. Select Windows Update. Select Check for updates. Install all applicable updates. Restart the computer when Windows asks you to.",
      "durationInFrames": 120
    },
    {
      "type": "outro",
      "heading": "Read the full article",
      "body": "New posts every week on the blog.",
      "url": "techtips.fun",
      "durationInFrames": 105
    }
