    {
      "type": "point",
      "kicker": "Web Development",
      "heading": "Before you begin",
      "body": "A LinkedIn account (a personal account; Company Page admin access helps if you create the app under an organization).",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "Web Development",
      "heading": "Step 1: Create a LinkedIn developer app",
      "body": "Open the LinkedIn Developer Portal. Select Create App. Fill in the app name, description, and your application's logo.",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "Web Development",
      "heading": "Step 2: Add the products",
      "body": "On the app's Products page, request: Sign In with LinkedIn — provides the OpenID Connect identity, including the sub claim you need to build the…",
      "durationInFrames": 120
    },
    {
      "type": "point",
      "kicker": "Web Development",
      "heading": "Step 3: Configure the auth settings",
      "body": "Open the Auth page for your app. Add your redirect URL to the allowed redirect URLs list (for example http://localhost). Save the changes.",
      "durationInFrames": 120
    },
    {
      "type": "code",
      "kicker": "Code",
      "heading": "Step 4: Choose the scopes",
      "steps": [
        {
          "lang": "text",
          "meta": "",
          "value": "openid profile w_member_social",
          "code": "openid profile w_member_social",
          "tokens": [
