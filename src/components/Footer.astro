	</div>
	<p class="copyright">&copy; {today.getFullYear()} Techtips.fun All rights reserved.</p>
</footer>

<style>
	footer {
		padding: 3rem 1rem 4rem;
		background:
			radial-gradient(circle at 10% 0%, rgba(104, 112, 246, 0.36), transparent 38%),
			radial-gradient(circle at 90% 20%, rgba(90, 180, 255, 0.2), transparent 35%),
			linear-gradient(115deg, #0b0e19, #20264b);
		color: #aeb4d6;
		text-align: center;
	}

	.footer-sections {
		box-sizing: border-box;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		width: min(100%, 760px);
		margin: 0 auto;
		padding: 1.4rem;
		border: 1px solid rgba(217, 220, 255, 0.14);
		border-radius: 0.85rem;
		background: rgba(7, 10, 22, 0.18);
		text-align: left;
	}

.footer-label {
			margin: 0 0 0.75rem;
			color: #fff;
			font-size: 0.9rem;
			font-weight: 700;
			letter-spacing: 0.04em;
			line-height: 1.2;
			text-transform: uppercase;
		}

	.footer-section ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-section li + li {
		margin-top: 0.5rem;
	}

	.footer-section a {
		color: #c8ccff;
		font-size: 0.95rem;
		text-decoration: none;
	}

	.footer-section a:hover,
	.footer-section a:focus-visible {
		text-decoration: underline;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.3rem;
		height: 2.3rem;
		border: 1px solid rgba(217, 220, 255, 0.24);
		border-radius: 50%;
		color: #e9eaff;
		text-decoration: none;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		border-color: rgba(217, 220, 255, 0.55);
		color: #bfc4ff;
	}

	.copyright {
		margin: 1.25rem 0 0;
	}

	@media (max-width: 36rem) {
		.footer-sections {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			text-align: center;
		}
	}
</style>
