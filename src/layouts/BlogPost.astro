---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostShare from '../components/PostShare.astro';
import PostAuthor from '../components/PostAuthor.astro';
import { toTaxonomySlug } from '../utils/taxonomy';


type Props = CollectionEntry<'blog'>['data'] & {
	socialImage?: string;
	showToc?: boolean;
};


const props = Astro.props.frontmatter || Astro.props;
const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags = [],
	socialImage,
	showToc = false,
} = props;
const publishedTime = pubDate instanceof Date ? pubDate.toISOString() : undefined;
const modifiedTime = updatedDate instanceof Date ? updatedDate.toISOString() : undefined;
---


<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			socialImage={socialImage}
			type={socialImage ? 'article' : 'website'}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
			}
			article {
				width: min(100%, 760px);
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose,
			.post-content {
				width: 100%;
				max-width: none;
				box-sizing: border-box;
				margin: 0;
				padding: 1em;
