---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { toTaxonomySlug } from '../utils/taxonomy';

type Props = CollectionEntry<'blog'>['data'] & {
	socialImage?: string;
};

const props = Astro.props.frontmatter || Astro.props;
const { title, description, pubDate, updatedDate, heroImage, category, tags = [], socialImage } = props;
const publishedTime = pubDate instanceof Date ? pubDate.toISOString() : undefined;
const modifiedTime = updatedDate instanceof Date ? updatedDate.toISOString() : undefined;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			socialImage={socialImage}
			type={socialImage ? 'article' : 'website'}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.taxonomy {
				align-items: center;
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
				justify-content: center;
				margin-top: 0.9rem;
			}
			.taxonomy-label {
				color: rgb(var(--gray));
				font-size: 0.85rem;
				font-weight: 700;
				margin-right: 0.1rem;
				text-transform: uppercase;
			}
			.taxonomy a {
				background: rgba(var(--gray-light), 0.55);
				border-radius: 999px;
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				padding: 0.32rem 0.65rem;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.taxonomy a:hover {
				background: rgb(var(--accent));
				color: white;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{(category || tags.length > 0) && (
							<div class="taxonomy" aria-label="Post taxonomy">
								{category && <><span class="taxonomy-label">Category</span><a href={`/categories/${toTaxonomySlug(category)}/`}>{category}</a></>}
								{tags.length > 0 && <span class="taxonomy-label">Tags</span>}
								{tags.map((tag: string) => <a href={`/tags/${toTaxonomySlug(tag)}/`}>#{tag}</a>)}
							</div>
						)}

						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
