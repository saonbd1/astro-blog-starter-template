---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			socialImage: `/og/${post.id}.png`,
		},
	}));
}

type Props = {
	post: CollectionEntry<'blog'>;
	socialImage: string;
};

const { post, socialImage } = Astro.props;
const { Content, headings } = await render(post);

// Only h2/h3 sections belong in the table of contents. Astro also reports any
// h1/h4+ headings found in the body (some posts demo Markdown heading syntax).
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<BlogPost {...post.data} socialImage={socialImage} showToc headings={toc}>
	<Content />
</BlogPost>
